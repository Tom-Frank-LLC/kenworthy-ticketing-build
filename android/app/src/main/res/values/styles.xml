<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Every window here is the page's #0f0f0f, never the platform's white.
         Until the WebView paints, and on WebViews older than 140 (where Capacitor
         pads the WebView clear of the system bars instead of drawing under them),
         the status and navigation bars show the window background. A light theme
         put white bars with white icons there. Dark parents also make the bar
         icons light, matching StatusBar.setStyle(Style.Dark) in src/main.tsx. -->

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/ic_launcher_background</item>
        <item name="colorPrimaryDark">@color/ic_launcher_background</item>
        <item name="colorAccent">#D4A247</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
