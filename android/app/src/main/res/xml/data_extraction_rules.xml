<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or carried to a new phone. The app's data is a
     WebView's localStorage, which holds the Supabase session; restored onto
     another device it would sign that device in as whoever used this one —
     on a staff phone, as staff. Signing in again is the cheaper failure. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
