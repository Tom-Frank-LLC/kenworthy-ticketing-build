{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kenworthy-ticketing-build",
  "compatibility_date": "2026-07-20",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "kenworthy-ticketing-staging"
    }
  }
}